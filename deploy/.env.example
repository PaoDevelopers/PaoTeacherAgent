# Copy to deploy/.env and fill in. deploy/.env is git-ignored; never commit it.
# Anything from deployment/docker_compose/env.template can also go here.

# --- Version -----------------------------------------------------------------
# Must match the upstream release tag our fork is based on (see CUSTOMIZATIONS.md).
IMAGE_TAG=v5.0.1

# --- Secrets (generate each with: openssl rand -hex 32) ----------------------
USER_AUTH_SECRET=
ENCRYPTION_KEY_SECRET=
POSTGRES_PASSWORD=

# --- URL ---------------------------------------------------------------------
# Local: http://localhost   Production: https://<your domain>
WEB_DOMAIN=http://localhost

# --- Sign-in -----------------------------------------------------------------
# Only these email domains may sign in, e.g. ykpaoschool.cn
VALID_EMAIL_DOMAINS=
OIDC_PKCE_ENABLED=true

# --- Privacy -----------------------------------------------------------------
# Stops anonymous usage telemetry to telemetry.onyx.app. Leave POSTHOG_API_KEY,
# SENTRY_DSN and BRAINTRUST_API_KEY unset so nothing else leaves the server.
DISABLE_TELEMETRY=true

# --- Services we don't use ---------------------------------------------------
# MCP server lets external AI clients query Onyx; not needed here.
MCP_SERVER_ENABLED=false
