POSTGRES_URL=postgresql://postgres:changeme@db.example.com:5432/postgres
# Bundled Postgres only: set its password here and use host relational_db in POSTGRES_URL.
POSTGRES_PASSWORD=changeme
USER_AUTH_SECRET=changeme
ENCRYPTION_KEY_SECRET=changeme
DEEPSEEK_API_KEY=changeme
WEB_DOMAIN=http://localhost
VALID_EMAIL_DOMAINS=
OIDC_PKCE_ENABLED=true
# The dean's Microsoft address(es), comma separated. An account created with one of
# these becomes an admin (the dean's page needs it). It applies when the account is first
# created, so it does not promote someone who has already signed in.
DEAN_EMAILS=
